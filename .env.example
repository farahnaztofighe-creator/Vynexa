# Copy values into your hosting provider's Environment Variables panel.
TELEGRAM_BOT_TOKEN=
# Optional: V2Route API key. Rotate the key that was previously embedded in source code.
V2ROUTE_TOKEN=
# Optional card-to-card payment details (or set them in the bot admin/config).
CARD_NUMBER=
CARD_NAME=
# FadeHost persistent data volume. Only set this on a host that supports /data.
VYNEXA_DATA_DIR=/data
